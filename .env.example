# ==============================================================================
# Database Configuration (PostgreSQL for MLflow Backend Store)
# ==============================================================================
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123

# ==============================================================================
# Object Storage Configuration (MinIO for Artifact Store)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# AWS S3 Client credentials (used by MinIO init & MLflow tracking)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# MLflow Tracking Configuration
# ==============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ==============================================================================
# Model Serving (FastAPI)
# ==============================================================================
MODEL_NAME=BreastCancerRandomForest
MODEL_ALIAS=latest
